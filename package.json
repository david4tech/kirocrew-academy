{
  "name": "kirocrew-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Gamified learning platform for mastering KiroCrew, from basics to advanced orchestration",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "api",
    "web",
    "infra"
  ],
  "scripts": {
    "build:shared": "npm run build -w @kirocrew-academy/shared",
    "build:content": "node scripts/build-content.mjs",
    "build:api": "npm run build -w @kirocrew-academy/api",
    "build:web": "npm run build -w @kirocrew-academy/web",
    "build": "npm run build:shared && npm run build:content && npm run build:api && npm run build:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @kirocrew-academy/web",
    "cdk": "npm run cdk -w @kirocrew-academy/infra --"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
